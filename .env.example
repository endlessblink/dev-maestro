# Watchpost Configuration
# Copy this file to .env and modify as needed.

# ─── Server ──────────────────────────────────────────────────────────────────

# Server port (default: 6010)
PORT=6010

# Path to MASTER_PLAN.md (absolute or relative path)
# Default: ../docs/MASTER_PLAN.md (relative to watchpost directory)
# For standalone installs, point to your project's MASTER_PLAN:
# MASTER_PLAN_PATH=/path/to/your/project/docs/MASTER_PLAN.md

# ─── Cross-platform overrides (optional) ─────────────────────────────────────
# These let Watchpost run identically on Linux, macOS, and Windows.
# Defaults are computed from the OS, so you only need to set them when you
# want to override the conventional locations.

# Watchpost install directory
# Linux/macOS default: <repo root>
# Windows default:     %USERPROFILE%\.watchpost (when installed via install-windows.ps1)
# WATCHPOST_DIR=

# Data directory (covers, summaries, heartbeats.jsonl, changelog/)
# Default: <WATCHPOST_DIR>/data
# WATCHPOST_DATA_DIR=

# projects.json registry file
# Default: <WATCHPOST_DIR>/projects.json
# WATCHPOST_PROJECTS_FILE=

# Claude Code session JSONL location(s) — comma-separated for multi-source.
# Linux/macOS default: ~/.claude/projects
# Windows default:     %USERPROFILE%\.claude\projects
# Multi-source example (WSL + native Windows):
#   WATCHPOST_CLAUDE_PROJECTS_DIRS=C:\Users\you\.claude\projects,\\wsl$\Ubuntu\home\you\.claude\projects
# WATCHPOST_CLAUDE_PROJECTS_DIR=
# WATCHPOST_CLAUDE_PROJECTS_DIRS=

# OpenCode storage location(s)
# Linux default:   ~/.local/share/opencode/storage
# macOS default:   ~/Library/Application Support/opencode/storage
# Windows default: %APPDATA%\opencode\storage
# WATCHPOST_OPENCODE_STORAGE_DIR=
# WATCHPOST_OPENCODE_STORAGE_DIRS=

# ─── Cross-OS path mappings (optional) ───────────────────────────────────────
# When the SAME projects.json is shared between Linux and Windows (dual-boot
# with NTFS data drive, or WSL <-> native), define how paths translate.
# JSON array; same shape can also live in projects.json under "pathMappings".
#
# WATCHPOST_PATH_MAPPINGS=[{"linux":"/media/endlessblink/data","windows":"D:\\"},{"linux":"/home/endlessblink","windows":"C:\\Users\\endlessblink"}]
