#!/bin/bash
# Dev Maestro quick start script

DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR"

# TUI subcommand — launch terminal kanban board
if [ "$1" = "tui" ]; then
  exec node "$DIR/tui/src/index.js"
fi

# Archive subcommand — move old DONE tasks to archive file
if [ "$1" = "archive" ]; then
  shift
  exec node "$DIR/tui/src/archive-cli.js" "$@"
fi

# Kill any existing instance
pkill -f "node server.js" 2>/dev/null

# Start the server
npm start
