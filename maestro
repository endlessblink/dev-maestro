#!/bin/bash
# Dev Maestro — Smart Launcher
# Usage: maestro [tui|dashboard|both|archive|status|stop]

DIR="$(cd "$(dirname "$0")" && pwd)"
PORT="${PORT:-6010}"

# Colors
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# Check if dashboard server is running
is_server_running() {
  curl -s "http://localhost:${PORT}/api/status" >/dev/null 2>&1
}

# Start dashboard server in background
start_server() {
  cd "$DIR"
  node server.js > /tmp/maestro-server.log 2>&1 &
  local pid=$!
  echo -e "${GREEN}Dashboard starting on http://localhost:${PORT}${NC} (PID: $pid)"
  # Wait for it to be ready
  for i in {1..10}; do
    sleep 1
    if is_server_running; then
      echo -e "${GREEN}Dashboard ready.${NC}"
      return 0
    fi
  done
  echo -e "${RED}Dashboard failed to start. Check /tmp/maestro-server.log${NC}"
  return 1
}

# Open dashboard in browser
open_dashboard() {
  local url="http://localhost:${PORT}"
  if command -v xdg-open &>/dev/null; then
    xdg-open "$url" 2>/dev/null &
  elif command -v open &>/dev/null; then
    open "$url" 2>/dev/null &
  else
    echo -e "${CYAN}Open in browser: ${url}${NC}"
  fi
}

# Start TUI
start_tui() {
  cd "$DIR"
  exec node "$DIR/tui/src/index.js"
}

# Show status
show_status() {
  if is_server_running; then
    local info
    info=$(curl -s "http://localhost:${PORT}/api/status" 2>/dev/null)
    local version=$(echo "$info" | grep -o '"version":"[^"]*"' | cut -d'"' -f4)
    local project=$(echo "$info" | grep -o '"masterPlanPath":"[^"]*"' | cut -d'"' -f4)
    echo -e "${GREEN}Dashboard: running${NC} on http://localhost:${PORT} (v${version})"
    echo -e "${DIM}Project: ${project}${NC}"
  else
    echo -e "${DIM}Dashboard: not running${NC}"
  fi
}

# Stop server
stop_server() {
  if is_server_running; then
    local pid=$(lsof -ti:${PORT} 2>/dev/null)
    if [ -n "$pid" ]; then
      kill "$pid" 2>/dev/null
      echo -e "${YELLOW}Dashboard stopped.${NC}"
    fi
  else
    echo -e "${DIM}Dashboard is not running.${NC}"
  fi
}

# Interactive menu
show_menu() {
  local server_running=false
  is_server_running && server_running=true

  echo ""
  echo -e "${BOLD}${CYAN}  Dev Maestro${NC}"
  echo ""

  if $server_running; then
    echo -e "  ${GREEN}Dashboard is running${NC} on http://localhost:${PORT}"
  else
    echo -e "  ${DIM}Dashboard is not running${NC}"
  fi
  echo ""

  # Build menu options based on state
  if $server_running; then
    echo -e "  ${BOLD}1${NC}) Open TUI (terminal board)"
    echo -e "  ${BOLD}2${NC}) Open Dashboard (browser)"
    echo -e "  ${BOLD}3${NC}) Stop Dashboard"
    echo -e "  ${BOLD}q${NC}) Quit"
  else
    echo -e "  ${BOLD}1${NC}) Open TUI (terminal board)"
    echo -e "  ${BOLD}2${NC}) Start Dashboard + Open Browser"
    echo -e "  ${BOLD}3${NC}) Start Both (Dashboard + TUI)"
    echo -e "  ${BOLD}q${NC}) Quit"
  fi
  echo ""
  read -p "  Choose [1-3/q]: " choice

  case "$choice" in
    1)
      if ! $server_running; then
        echo -e "${DIM}Starting dashboard in background first...${NC}"
        start_server
      fi
      start_tui
      ;;
    2)
      if $server_running; then
        open_dashboard
        echo -e "${GREEN}Opened dashboard in browser.${NC}"
      else
        start_server && open_dashboard
      fi
      ;;
    3)
      if $server_running; then
        stop_server
      else
        start_server && open_dashboard
        echo ""
        start_tui
      fi
      ;;
    q|Q|"")
      exit 0
      ;;
    *)
      echo -e "${RED}Invalid choice.${NC}"
      exit 1
      ;;
  esac
}

# ============================================================================
# SUBCOMMANDS
# ============================================================================
case "${1:-}" in
  tui)
    # Ensure server is running, then launch TUI
    if ! is_server_running; then
      echo -e "${DIM}Starting dashboard in background...${NC}"
      start_server
    fi
    start_tui
    ;;
  dashboard|dash|web)
    if ! is_server_running; then
      start_server
    fi
    open_dashboard
    echo -e "${GREEN}Dashboard: http://localhost:${PORT}${NC}"
    ;;
  both)
    if ! is_server_running; then
      start_server
    fi
    open_dashboard
    start_tui
    ;;
  status)
    show_status
    ;;
  stop)
    stop_server
    ;;
  archive)
    shift
    exec node "$DIR/tui/src/archive-cli.js" "$@"
    ;;
  install)
    shift
    exec bash "$DIR/install.sh" "$@"
    ;;
  help|--help|-h)
    echo -e "${CYAN}Dev Maestro${NC} — AI orchestration dashboard"
    echo ""
    echo "Usage: maestro [command]"
    echo ""
    echo "Commands:"
    echo "  (none)        Interactive menu"
    echo "  tui           Launch terminal board"
    echo "  dashboard     Start dashboard + open browser"
    echo "  both          Start dashboard + open TUI"
    echo "  status        Show running status"
    echo "  stop          Stop dashboard server"
    echo "  archive       Archive done tasks"
    echo "  install       Install/configure a project"
    echo "  help          Show this help"
    ;;
  "")
    show_menu
    ;;
  *)
    echo -e "${RED}Unknown command: $1${NC}"
    echo "Run 'maestro help' for usage."
    exit 1
    ;;
esac
